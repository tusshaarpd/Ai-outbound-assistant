OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Model routing (aligned to CrewAI LLM model IDs)
RESEARCHER_MODEL=gpt-4o-mini
DRAFTER_MODEL=claude-sonnet-4-5-20250929
REVIEWER_MODEL=claude-opus-4-7
MANAGER_MODEL=claude-opus-4-7

# Guardrail thresholds
SPAM_COMPLAINT_KILL_THRESHOLD=0.001
UNSUBSCRIBE_KILL_THRESHOLD=0.02
BOUNCE_KILL_THRESHOLD=0.05
HUMAN_REVIEW_THRESHOLD_MESSAGES=1000

# Demo toggles
DEMO_MODE=true
CREWAI_VERBOSE=true

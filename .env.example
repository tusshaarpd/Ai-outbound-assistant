# Local development. For Streamlit Cloud deployments, use Streamlit Secrets
# instead — see .streamlit/secrets.toml.example.
#
# Copy: cp .env.example .env  →  fill the placeholders.
# At least one of OPENAI_API_KEY / ANTHROPIC_API_KEY must be set.

# --- Required: at least one provider ---
OPENAI_API_KEY=sk-REPLACE_ME
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# --- Optional: model routing (defaults pick sane fallbacks if only one
# provider is configured) ---
RESEARCHER_MODEL=gpt-4o-mini
DRAFTER_MODEL=claude-sonnet-4-5-20250929
REVIEWER_MODEL=claude-opus-4-7
MANAGER_MODEL=claude-opus-4-7

# --- Optional: guardrail thresholds ---
SPAM_COMPLAINT_KILL_THRESHOLD=0.001
UNSUBSCRIBE_KILL_THRESHOLD=0.02
BOUNCE_KILL_THRESHOLD=0.05
HUMAN_REVIEW_THRESHOLD_MESSAGES=1000

# --- Optional: demo toggles ---
DEMO_MODE=true
CREWAI_VERBOSE=true

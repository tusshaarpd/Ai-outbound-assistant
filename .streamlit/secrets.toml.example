# Copy this file to `.streamlit/secrets.toml` for local Streamlit dev,
# OR paste these key=value pairs into Streamlit Cloud's UI:
#   App page → Manage app → Settings → Secrets
#
# OpenAI-only deploy: OPENAI_API_KEY is the only provider key required.

# --- Required ---
OPENAI_API_KEY = "sk-REPLACE_ME"

# --- Optional: model routing overrides (must be OpenAI model IDs) ---
# RESEARCHER_MODEL = "gpt-4o-mini"
# DRAFTER_MODEL    = "gpt-4o"
# REVIEWER_MODEL   = "gpt-4o"
# MANAGER_MODEL    = "gpt-4o"
# SENDER_MODEL     = "gpt-4o-mini"

# --- Optional: guardrail thresholds ---
# SPAM_COMPLAINT_KILL_THRESHOLD = "0.001"
# UNSUBSCRIBE_KILL_THRESHOLD    = "0.02"
# BOUNCE_KILL_THRESHOLD         = "0.05"
# HUMAN_REVIEW_THRESHOLD_MESSAGES = "1000"

# --- Optional: demo toggles ---
# DEMO_MODE       = "true"
# CREWAI_VERBOSE  = "true"
